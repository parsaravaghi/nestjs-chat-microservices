    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.0.1",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.0.1",
    "amqp": "^0.2.7",
    "amqp-connection-manager": "^5.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
