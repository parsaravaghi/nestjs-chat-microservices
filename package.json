  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/nestjs-authentication-microservice/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "jest --config jest.unit.config.cjs",
    "test:integration": "jest --config jest.integration.config.cjs",
    "test:e2e": "jest --config jest.e2e.config.cjs",
    "test:watch": "npm run test:unit -- --watch",
    "test:cov": "npm run test:unit -- --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/jest/bin/jest.js --config jest.unit.config.cjs --runInBand"
  },
  "dependencies": {
    "@jest/globals": "^30.4.1",
